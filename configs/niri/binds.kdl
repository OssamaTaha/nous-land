// ───────────────────────────────────────────────────────
// NOUS LAND — Niri Keybinds
// Shared keybind philosophy with Hyprland
// ───────────────────────────────────────────────────────

// ── Terminal & App Launchers ────────────────────────
bind "Super+Q" { spawn "kitty"; }
bind "Super+Space" { spawn "wofi --show drun"; }
bind "Super+Shift+Space" { spawn "wofi --show run"; }

// ── AI Agent (Hermes) ──────────────────────────────
bind "Super+A" { spawn "python3 ~/.config/nous-agent/ui.py"; }

// ── Close window ────────────────────────────────────
bind "Super+C" { close-window; }
bind "Super+Shift+C" { kill-delay "1s"; }

// ── Exit Niri ───────────────────────────────────────
bind "Super+Shift+Q" { quit; }

// ── Toggle fullscreen ───────────────────────────────
bind "Super+F" { toggle-fullscreen; }

// ── Toggle floating mode ────────────────────────────
bind "Super+V" { toggle-floating; }

// ── Move focus (arrow keys) ────────────────────────
bind "Super+Left" { focus-left; }
bind "Super+Right" { focus-right; }
bind "Super+Up" { focus-up; }
bind "Super+Down" { focus-down; }

// ── Move window (Super+Shift+Arrow) ─────────────────
bind "Super+Shift+Left" { move-left; }
bind "Super+Shift+Right" { move-right; }
bind "Super+Shift+Up" { move-up; }
bind "Super+Shift+Down" { move-down; }

// ── Workspaces (Super+1-10) ───────────────────────
bind "Super+1" { go-to-workspace "1"; }
bind "Super+2" { go-to-workspace "2"; }
bind "Super+3" { go-to-workspace "3"; }
bind "Super+4" { go-to-workspace "4"; }
bind "Super+5" { go-to-workspace "5"; }
bind "Super+6" { go-to-workspace "6"; }
bind "Super+7" { go-to-workspace "7"; }
bind "Super+8" { go-to-workspace "8"; }
bind "Super+9" { go-to-workspace "9"; }
bind "Super+0" { go-to-workspace "10"; }

// ── Move to workspace (Super+Shift+1-10) ──────────
bind "Super+Shift+1" { move-to-workspace "1"; }
bind "Super+Shift+2" { move-to-workspace "2"; }
bind "Super+Shift+3" { move-to-workspace "3"; }
bind "Super+Shift+4" { move-to-workspace "4"; }
bind "Super+Shift+5" { move-to-workspace "5"; }
bind "Super+Shift+6" { move-to-workspace "6"; }
bind "Super+Shift+7" { move-to-workspace "7"; }
bind "Super+Shift+8" { move-to-workspace "8"; }
bind "Super+Shift+9" { move-to-workspace "9"; }
bind "Super+Shift+0" { move-to-workspace "10"; }

// ── Resize windows ──────────────────────────────────
bind "Super+Ctrl+Left" { resize-edge "left" "-50"; }
bind "Super+Ctrl+Right" { resize-edge "right" "50"; }
bind "Super+Ctrl+Up" { resize-edge "up" "-50"; }
bind "Super+Ctrl+Down" { resize-edge "down" "50"; }

// ── Screenshot tools ────────────────────────────────
bind "Print" { screenshot; }
bind "Shift+Print" { screenshot-screen; }

// ── Volume controls ─────────────────────────────────
bind "XF86AudioRaiseVolume" { spawn "pamixer -i 5"; }
bind "XF86AudioLowerVolume" { spawn "pamixer -d 5"; }
bind "XF86AudioMute" { spawn "pamixer -t"; }

// ── Brightness controls ─────────────────────────────
bind "XF86MonBrightnessUp" { spawn "brightnessctl set +5%"; }
bind "XF86MonBrightnessDown" { spawn "brightnessctl set 5%-"; }

// ── Media controls ──────────────────────────────────
bind "XF86AudioPlay" { spawn "playerctl play-pause"; }
bind "XF86AudioNext" { spawn "playerctl next"; }
bind "XF86AudioPrev" { spawn "playerctl previous"; }

// ── Lock screen ─────────────────────────────────────
bind "Super+Shift+L" { spawn "hyprlock"; }

// ── Theme switching ──────────────────────────────────
bind "Super+T" { spawn "bash ~/.local/bin/theme-switcher-gui.sh"; }

// ── Reload config ───────────────────────────────────
bind "Super+Shift+R" { reload-config; }
